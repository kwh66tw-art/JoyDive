    "Touch and drag the profile to inspect any moment of the dive." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berühre und ziehe über das Profil, um jeden Moment des Tauchgangs zu untersuchen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αγγίξτε και σύρετε το προφίλ για να εξετάσετε οποιαδήποτε στιγμή της κατάδυσης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and drag the profile to inspect any moment of the dive."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and drag the profile to inspect any moment of the dive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca y arrastra el perfil para inspeccionar cualquier momento de la inmersión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez et faites glisser le profil pour examiner n'importe quel instant de la plongée."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirnite i povucite profil kako biste pregledali bilo koji trenutak urona."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentuh dan geser profil untuk memeriksa momen mana pun dalam penyelaman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca e trascina il profilo per esaminare qualsiasi momento dell'immersione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルをタッチしてドラッグすると、潜水中の任意の瞬間を確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로필을 터치하고 드래그하면 다이빙의 특정 순간을 확인할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentuh dan seret profil untuk memeriksa mana-mana detik semasa selaman."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raak het profiel aan en sleep om elk moment van de duik te bekijken."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque e arraste o perfil para inspecionar qualquer momento do mergulho."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะและลากโปรไฟล์เพื่อตรวจสอบช่วงเวลาใด ๆ ของการดำน้ำ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm và kéo trên hồ sơ để xem bất kỳ thời điểm nào của lần lặn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "触摸并拖曳剖面图，可查看潜水过程中任一时刻的状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "觸摸並拖曳剖面圖，可查看潛水過程中任一時刻的狀態。"
          }
        }
      }
    },
