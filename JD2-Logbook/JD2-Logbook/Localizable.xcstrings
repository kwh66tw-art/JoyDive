    "Language changes take effect right away. Some system-provided panels may still use the device language until you reopen the app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprachänderungen wirken sofort. Manche vom System bereitgestellten Ansichten verwenden bis zum nächsten App-Start weiterhin die Gerätesprache."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι αλλαγές γλώσσας ισχύουν αμέσως. Ορισμένα παράθυρα του συστήματος ενδέχεται να συνεχίσουν να χρησιμοποιούν τη γλώσσα της συσκευής μέχρι να ανοίξετε ξανά την εφαρμογή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Language changes take effect right away. Some system-provided panels may still use the device language until you reopen the app."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Language changes take effect right away. Some system-provided panels may still use the device language until you reopen the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios de idioma se aplican de inmediato. Algunos paneles del sistema pueden seguir usando el idioma del dispositivo hasta que vuelvas a abrir la aplicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les changements de langue prennent effet immédiatement. Certains panneaux fournis par le système peuvent continuer à utiliser la langue de l'appareil jusqu'à ce que vous rouvriez l'application."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promjene jezika stupaju na snagu odmah. Neki sustavski prozori mogu i dalje koristiti jezik uređaja dok ponovno ne otvorite aplikaciju."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perubahan bahasa langsung berlaku. Beberapa panel bawaan sistem mungkin masih menggunakan bahasa perangkat hingga Anda membuka ulang aplikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modifiche alla lingua hanno effetto immediato. Alcuni pannelli di sistema potrebbero continuare a usare la lingua del dispositivo finché non riapri l'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言語の変更はすぐに反映されます。一部のシステム提供パネルは、アプリを再度開くまで端末の言語のままになる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "언어 변경은 즉시 적용됩니다. 일부 시스템 제공 패널은 앱을 다시 열 때까지 기기 언어를 계속 사용할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perubahan bahasa berkuat kuasa serta-merta. Sesetengah panel sistem mungkin masih menggunakan bahasa peranti sehingga anda membuka semula aplikasi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taalwijzigingen worden meteen toegepast. Sommige systeempanelen gebruiken mogelijk nog de apparaattaal totdat je de app opnieuw opent."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As alterações de idioma têm efeito imediato. Alguns painéis do sistema podem continuar a usar o idioma do dispositivo até reabrir a aplicação."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเปลี่ยนภาษาจะมีผลทันที บางแผงที่มาจากระบบอาจยังคงใช้ภาษาของอุปกรณ์จนกว่าคุณจะเปิดแอปอีกครั้ง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thay đổi ngôn ngữ có hiệu lực ngay lập tức. Một số bảng điều khiển của hệ thống có thể vẫn dùng ngôn ngữ thiết bị cho đến khi bạn mở lại ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语言更改会立即生效。部分系统提供的面板在您重新打开 App 前可能仍会使用设备语言。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "語言變更會立即生效。部分系統提供的面板在您重新開啟 App 前可能仍會使用裝置語言。"
          }
        }
      }
    },
    "Language, appearance, and preferences will be available in a future update." : {
      "comment" : "Settings placeholder description",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprache, Erscheinungsbild und Einstellungen werden in einem zukünftigen Update verfügbar sein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η γλώσσα, η εμφάνιση και οι προτιμήσεις θα είναι διαθέσιμες σε μελλοντική ενημέρωση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Language, appearance, and preferences will be available in a future update."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Language, appearance, and preferences will be available in a future update."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El idioma, la apariencia y las preferencias estarán disponibles en una próxima actualización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La langue, l'apparence et les préférences seront disponibles dans une prochaine mise à jour."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jezik, izgled i postavke bit će dostupni u budućem ažuriranju."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahasa, tampilan, dan preferensi akan tersedia dalam pembaruan mendatang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lingua, aspetto e preferenze saranno disponibili in un prossimo aggiornamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言語、外観、環境設定は今後のアップデートで利用可能になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "언어, 화면 스타일 및 환경 설정은 향후 업데이트에서 지원될 예정입니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahasa, penampilan dan keutamaan akan tersedia dalam kemas kini masa hadapan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taal, weergave en voorkeuren komen beschikbaar in een toekomstige update."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O idioma, a aparência e as preferências estarão disponíveis numa atualização futura."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ภาษา รูปลักษณ์ และการตั้งค่าจะพร้อมใช้งานในการอัปเดตในอนาคต."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngôn ngữ, giao diện và tùy chọn sẽ khả dụng trong bản cập nhật tương lai."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语言、外观与偏好设置将在后续版本中提供。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "語言、外觀與偏好設定將在後續版本中提供。"
