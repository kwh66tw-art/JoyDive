    "Estimated using Bühlmann ZHL-16C from the imported profile only. Not a substitute for your dive computer or certified decompression software." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geschätzt mit Bühlmann ZHL-16C ausschließlich auf Basis des importierten Profils. Kein Ersatz für Ihren Tauchcomputer oder zertifizierte Dekompressionssoftware."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εκτίμηση με χρήση Bühlmann ZHL-16C μόνο από το εισαγόμενο προφίλ. Δεν υποκαθιστά τον υπολογιστή κατάδυσης ή πιστοποιημένο λογισμικό αποσυμπίεσης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimated using Bühlmann ZHL-16C from the imported profile only. Not a substitute for your dive computer or certified decompression software."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimated using Bühlmann ZHL-16C from the imported profile only. Not a substitute for your dive computer or certified decompression software."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimado con Bühlmann ZHL-16C solo a partir del perfil importado. No sustituye a tu ordenador de buceo ni a un software de descompresión certificado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimation avec Bühlmann ZHL-16C basée uniquement sur le profil importé. Ne remplace pas votre ordinateur de plongée ni un logiciel de décompression certifié."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procijenjeno pomoću Bühlmann ZHL-16C samo na temelju uvezenog profila. Nije zamjena za vaš ronilački računalo ili certificirani softver za dekompresiju."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diperkirakan menggunakan Bühlmann ZHL-16C hanya dari profil yang diimpor. Bukan pengganti dive computer atau perangkat lunak dekompresi bersertifikat Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimato con Bühlmann ZHL-16C basandosi solo sul profilo importato. Non sostituisce il tuo computer subacqueo o un software di decompressione certificato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インポートしたプロファイルのみから Bühlmann ZHL-16C で推定しています。ダイブコンピューターや認定された減圧ソフトウェアの代わりにはなりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가져온 프로필만을 기반으로 Bühlmann ZHL-16C를 사용해 추정한 값입니다. 다이브 컴퓨터나 공인 감압 소프트웨어를 대체할 수 없습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dianggarkan menggunakan Bühlmann ZHL-16C hanya daripada profil yang diimport. Bukan pengganti komputer selam atau perisian dekompresi bertauliah anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geschat met Bühlmann ZHL-16C, uitsluitend op basis van het geïmporteerde profiel. Geen vervanging voor je duikcomputer of gecertificeerde decompressiesoftware."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimado com Bühlmann ZHL-16C apenas a partir do perfil importado. Não substitui o seu computador de mergulho ou software de descompressão certificado."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ประมาณการโดยใช้ Bühlmann ZHL-16C จากโปรไฟล์ที่นำเข้าเท่านั้น ไม่สามารถใช้ทดแทนคอมพิวเตอร์ดำน้ำหรือซอฟต์แวร์ลดความดันที่ได้รับการรับรอง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ước tính bằng Bühlmann ZHL-16C chỉ dựa trên hồ sơ đã nhập. Không thay thế cho máy tính lặn hoặc phần mềm giảm áp được chứng nhận của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅根据导入的剖面数据，使用 Bühlmann ZHL-16C 估算。不能替代您的潜水电脑或经认证的减压软件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅根據匯入的剖面資料，使用 Bühlmann ZHL-16C 估算。不能取代您的潛水電腦或經認證的減壓軟體。"
          }
        }
      }
    },
