    "One-time purchase. No subscription.\\nUnlock Premium to backup and export all your dives." : {
      "comment" : "Auto generated key: One-time purchase. No subscription.\\nUnlock Premium to backup and export all your dives.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmaliger Kauf. Kein Abonnement.\\nSchalten Sie Premium frei, um alle Ihre Tauchgänge zu sichern und zu exportieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αγορά μία φορά. Χωρίς συνδρομή.\\nΞεκλειδώστε το Premium για να δημιουργήσετε αντίγραφα ασφαλείας και να εξαγάγετε όλες τις καταδύσεις σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One-time purchase. No subscription.\\nUnlock Premium to backup and export all your dives."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One-time purchase. No subscription.\\nUnlock Premium to backup and export all your dives."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compra única. Sin suscripción.\\nDesbloquea Premium para respaldar y exportar todas tus inmersiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achat unique. Sans abonnement.\\nDéverrouillez le Premium pour sauvegarder et exporter toutes vos plongées."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednokratna kupnja. Bez pretplate.\\nOtključajte Premium za sigurnosnu kopiju i izvoz svih svojih urona."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembelian sekali. Tanpa langganan.\\nBuka kunci Premium untuk mencadangkan dan mengeksport semua penyelaman Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acquisto una tantum. Nessun abbonamento.\\nSblocca Premium per eseguire il backup ed esportare tutte le tue immersioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一回限りの購入。サブスクリプションなし。\\nすべてのダイビングをバックアップおよび書き出すには、プレミアムのロックを解除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일회성 구매. 구독 없음.\\n모든 다이빙을 백업하고 내보내려면 프리미엄을 잠금 해제하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembelian sekali sahaja. Tiada langganan.\\nBuka kunci Premium untuk menyandar dan mengeksport semua selam anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eenmalige aankoop. Geen abonnement.\\nOntgrendel Premium om al je duiken te back-uppen en te exporteren."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compra única. Sem subscrição.\\nDesbloqueie o Premium para salvaguardar e exportar todos os seus mergulhos."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ซื้อครั้งเดียว ไม่มีระบบสมาชิก\\nปลดล็อกพรีเมียมเพื่อสำรองข้อมูลและส่งออกไดฟ์ทั้งหมดของคุณ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mua một lần. Không cần đăng ký.\\nMở khóa Premium để sao lưu và xuất tất cả các chuyến lặn của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次性购买，无需订阅。\n解锁专业版即可备份并导出所有潜水记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
