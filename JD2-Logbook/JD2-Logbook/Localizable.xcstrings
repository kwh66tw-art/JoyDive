    "Tissue nitrogen loading isn't available for trimix dives yet — this is a known limitation, not an error." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Gewebestickstoffbelastung ist für Trimix-Tauchgänge noch nicht verfügbar — dies ist eine bekannte Einschränkung, kein Fehler."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η φόρτιση αζώτου στους ιστούς δεν είναι ακόμη διαθέσιμη για καταδύσεις trimix — αυτός είναι ένας γνωστός περιορισμός, όχι σφάλμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tissue nitrogen loading isn't available for trimix dives yet — this is a known limitation, not an error."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tissue nitrogen loading isn't available for trimix dives yet — this is a known limitation, not an error."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carga de nitrógeno en tejidos aún no está disponible para inmersiones con trimix — esta es una limitación conocida, no un error."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La saturation en azote tissulaire n'est pas encore disponible pour les plongées au trimix — il s'agit d'une limitation connue, pas d'une erreur."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opterećenje tkiva dušikom još nije dostupno za trimix zarone — ovo je poznato ograničenje, a ne pogreška."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beban nitrogen jaringan belum tersedia untuk penyelaman trimix — ini adalah batasan yang diketahui, bukan kesalahan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il carico di azoto nei tessuti non è ancora disponibile per le immersioni trimix: si tratta di una limitazione nota, non di un errore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trimix（トリミックス）ダイビングの組織窒素負荷はまだ対応していません。これは既知の制限事項であり、エラーではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트라이믹스(Trimix) 다이빙의 조직 질소 부하는 아직 지원되지 않습니다. 이는 알려진 제한 사항이며 오류가 아닙니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beban nitrogen tisu belum tersedia untuk selaman trimix — ini adalah had yang diketahui, bukan ralat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weefselstikstofbelasting is nog niet beschikbaar voor trimixduiken — dit is een bekende beperking, geen fout."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A carga de azoto nos tecidos ainda não está disponível para mergulhos com trimix — esta é uma limitação conhecida, não um erro."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่รองรับการคำนวณการสะสมไนโตรเจนในเนื้อเยื่อสำหรับการดำน้ำแบบ Trimix — นี่เป็นข้อจำกัดที่รับทราบแล้ว ไม่ใช่ข้อผิดพลาด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tải lượng nitơ trong mô chưa khả dụng cho các chuyến lặn trimix — đây là giới hạn đã biết, không phải lỗi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trimix 潜水暂不支持组织氮负荷计算 — 这是已知限制，不是错误。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trimix 潛水暫不支援組織氮負荷計算 — 此為已知限制，非錯誤。"
          }
        }
      }
    },
