    "Location data stays on your device and is only requested while enabled." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standortdaten verbleiben auf deinem Gerät und werden nur bei Aktivierung angefragt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα δεδομένα τοποθεσίας παραμένουν στη συσκευή σας και ζητούνται μόνο όταν είναι ενεργοποιημένα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location data stays on your device and is only requested while enabled."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location data stays on your device and is only requested while enabled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de ubicación permanecen en tu dispositivo y solo se solicitan mientras está activado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données de localisation restent sur votre appareil et ne sont demandées que lorsque l'option est activée."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podaci o lokaciji ostaju na vašem uređaju i traže se samo dok je opcija omogućena."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data lokasi tetap di perangkat Anda dan hanya diminta saat diaktifkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati sulla posizione restano sul tuo dispositivo e vengono richiesti solo quando è attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報データは端末内に保存され、有効化している間のみ取得されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치 데이터는 기기에만 저장되며, 활성화된 동안에만 요청됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data lokasi kekal pada peranti anda dan hanya diminta semasa didayakan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locatiegegevens blijven op je apparaat en worden alleen opgevraagd wanneer dit is ingeschakeld."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados de localização permanecem no seu dispositivo e só são pedidos enquanto estiver ativado."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อมูลตำแหน่งจะถูกเก็บไว้ในอุปกรณ์ของคุณเท่านั้น และจะถูกร้องขอเฉพาะเมื่อเปิดใช้งาน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dữ liệu vị trí được lưu trên thiết bị của bạn và chỉ được yêu cầu khi tính năng này được bật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置数据仅保留在您的设备上，且仅在启用时才会请求。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置資料只會保留在您的裝置上，且僅在啟用時才會請求。"
          }
        }
      }
    },
