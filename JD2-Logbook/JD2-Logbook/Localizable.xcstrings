    "Safety stop became mandatory: ascent rate stayed above 10 m/min (32.8 ft/min) for 10 seconds." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Sicherheitsstopp ist jetzt obligatorisch: Die Aufstiegsrate blieb 10 Sekunden lang über 10 m/min (32,8 ft/min)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η στάση ασφαλείας έγινε υποχρεωτική: η ταχύτητα ανόδου παρέμεινε πάνω από 10 μ/λεπτό (32,8 πόδια/λεπτό) για 10 δευτερόλεπτα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safety stop became mandatory: ascent rate stayed above 10 m/min (32.8 ft/min) for 10 seconds."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safety stop became mandatory: ascent rate stayed above 10 m/min (32.8 ft/min) for 10 seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La parada de seguridad pasó a ser obligatoria: la velocidad de ascenso se mantuvo por encima de 10 m/min (32,8 pies/min) durante 10 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le palier de sécurité est devenu obligatoire : la vitesse de remontée est restée supérieure à 10 m/min (32,8 pi/min) pendant 10 secondes."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigurnosno zaustavljanje postalo je obavezno: brzina uspona ostala je iznad 10 m/min (32,8 ft/min) 10 sekundi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safety stop menjadi wajib: kecepatan naik tetap di atas 10 m/menit (32.8 ft/menit) selama 10 detik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sosta di sicurezza è diventata obbligatoria: la velocità di risalita è rimasta sopra i 10 m/min (32,8 ft/min) per 10 secondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セーフティストップが必須になりました：浮上速度が10秒間 10 m/分（32.8 ft/分）を超えていました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안전 정지가 필수로 바뀌었습니다: 상승 속도가 10초 동안 10 m/분(32.8 ft/분)을 초과한 상태였습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safety stop menjadi wajib: kadar naik kekal melebihi 10 m/min (32.8 ka/min) selama 10 saat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De veiligheidsstop werd verplicht: de stijgsnelheid bleef 10 seconden lang boven 10 m/min (32,8 ft/min)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A paragem de segurança tornou-se obrigatória: a velocidade de subida manteve-se acima de 10 m/min (32,8 pés/min) durante 10 segundos."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การหยุดพักเพื่อความปลอดภัยกลายเป็นภาคบังคับ: อัตราการขึ้นสู่ผิวน้ำสูงกว่า 10 ม./นาที (32.8 ฟุต/นาที) นานติดต่อกัน 10 วินาที"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dừng an toàn trở thành bắt buộc: tốc độ lên duy trì trên 10 m/phút (32,8 ft/phút) trong 10 giây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全停留改为强制：上升速率持续超过 10 米/分（32.8 英尺/分）达 10 秒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全停留改為強制：上升速率持續超過 10 公尺/分（32.8 英呎/分）達 10 秒。"
          }
        }
      }
    },
