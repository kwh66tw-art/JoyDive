        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一回限りの購入。サブスクリプションなし。\\nすべてのダイビングをバックアップおよび書き出すには、プレミアムのロックを解除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일회성 구매. 구독 없음.\\n모든 다이빙을 백업하고 내보내려면 프리미엄을 잠금 해제하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembelian sekali sahaja. Tiada langganan.\\nBuka kunci Premium untuk menyandar dan mengeksport semua selam anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eenmalige aankoop. Geen abonnement.\\nOntgrendel Premium om al je duiken te back-uppen en te exporteren."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compra única. Sem subscrição.\\nDesbloqueie o Premium para salvaguardar e exportar todos os seus mergulhos."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ซื้อครั้งเดียว ไม่มีระบบสมาชิก\\nปลดล็อกพรีเมียมเพื่อสำรองข้อมูลและส่งออกไดฟ์ทั้งหมดของคุณ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mua một lần. Không cần đăng ký.\\nMở khóa Premium để sao lưu và xuất tất cả các chuyến lặn của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次性购买，无需订阅。\n解锁专业版即可备份并导出所有潜水记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次性購買，無需訂閱。\n解鎖進階版即可備份並匯出所有潛水記錄。"
          }
        }
      }
    },
