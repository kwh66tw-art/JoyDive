    "Export all dives to a JSON file, or restore from a previously exported file." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportiere alle Tauchgänge in eine JSON-Datei oder stelle sie aus einer zuvor exportierten Datei wieder her."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εξαγάγετε όλες τις καταδύσεις σε αρχείο JSON ή επαναφέρετε από ένα αρχείο που εξήχθη προηγουμένως."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export all dives to a JSON file, or restore from a previously exported file."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export all dives to a JSON file, or restore from a previously exported file."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta todas las inmersiones a un archivo JSON, o restaura desde un archivo exportado anteriormente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportez toutes les plongées vers un fichier JSON, ou restaurez à partir d'un fichier précédemment exporté."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvezite sve urone u JSON datoteku ili vratite iz prethodno izvezene datoteke."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekspor semua penyelaman ke file JSON, atau pulihkan dari file yang diekspor sebelumnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esporta tutte le immersioni in un file JSON, oppure ripristina da un file esportato in precedenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての潜水記録をJSONファイルに書き出す、または以前に書き出したファイルから復元します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 다이브를 JSON 파일로 내보내거나 이전에 내보낸 파일에서 복원하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksport semua selaman ke fail JSON, atau pulihkan daripada fail yang dieksport sebelum ini."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporteer alle duiken naar een JSON-bestand, of herstel vanuit een eerder geëxporteerd bestand."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporte todos os mergulhos para um ficheiro JSON, ou restaure a partir de um ficheiro exportado anteriormente."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่งออกการดำน้ำทั้งหมดเป็นไฟล์ JSON หรือกู้คืนจากไฟล์ที่เคยส่งออกไว้ก่อนหน้านี้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xuất tất cả các lần lặn ra tệp JSON, hoặc khôi phục từ tệp đã xuất trước đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将所有潜水记录导出为 JSON 文件，或从先前导出的文件还原。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將所有潛水記錄匯出為 JSON 檔案，或從先前匯出的檔案還原。"
          }
        }
      }
    },
